ENVIRONMENT=development
CORS_ORIGINS=*
DATABASE_URL=sqlite+aiosqlite:///./app.db
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
RAG_BACKEND=memory

GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
OPENSANCTIONS_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

WHED_URL=https://whed.net/results_institutions.php
SECP_SEARCH_URL=https://eservices.secp.gov.pk/eServices/NameSearch.jsp
APP_SECRET=change-me

# Per-call timeouts (seconds) - keep one slow external source from hanging
# an entire /verify run. asyncio.gather() runs sources concurrently but
# still waits for the slowest one unless each call has its own timeout.
LLM_CALL_TIMEOUT_SECONDS=25
WEB_RESEARCH_CALL_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
