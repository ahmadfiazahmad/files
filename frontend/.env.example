# --- Database (Postgres via Drizzle) ---
# REQUIRED UNCONDITIONALLY, even when BACKEND_URL is set below. The investigation
# CRUD flow (investigate/message/evidence/verify/results) is skipped in favor of
# the FastAPI backend when BACKEND_URL is configured, but auth/accounts
# (/api/auth/login, /api/auth/signup, /api/profile) and /api/health always use
# this database directly via src/db/index.ts, which throws at import time if
# DATABASE_URL is missing. Provision a real Postgres instance (e.g. Railway's
# Postgres addon) regardless of whether the FastAPI backend is used.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Optional LLM enrichment for the internal engine (src/server/llm.ts) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# --- Connect to the Python/FastAPI backend (server-side only, never sent to the browser) ---
# Set this to switch /api/investigate, /api/investigation/[id]/message, /api/evidence,
# /api/investigation/[id]/verify and /api/investigation/[id]/results over to the
# real backend in ../backend. Leave blank to keep using the internal deterministic
# engine (src/server/engine) with no external service required.
BACKEND_URL=http://localhost:8000

# --- Alternative client-side proxy (src/services/api.ts) ---
# Only needed if you want the BROWSER to call the backend directly instead of
# going through the Next.js route handlers above. Usually leave this unset.
# NEXT_PUBLIC_API_BASE_URL=
